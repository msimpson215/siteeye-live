# OpenAI API Key (required — AxonAI voice + text)
OPENAI_API_KEY=your_openai_api_key_here

# Optional
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_CHAT_MODEL=gpt-4o-mini

# Email (optional)
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

PORT=3000

# Private development gate (set AUTH_ENABLED=true on Render)
# AUTH_USERS format: user:pass,user2:pass2
# Optional per-brain access: user:pass:siteeye|tactical
AUTH_ENABLED=true
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_USERS=marty:change-me,axon:change-me
